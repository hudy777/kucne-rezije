rules_version = '2';
// Kućne režije: svi čitaju, samo vlasnik uređuje.
// ⬇️ ZAMIJENI email ispod istim emailom kao u www/config.js
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "ZAMIJENI@gmail.com";
    }
    match /bills/{billId} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
